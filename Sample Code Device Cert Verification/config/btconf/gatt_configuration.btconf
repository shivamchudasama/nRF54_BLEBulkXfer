        <read authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>

    <!--Certificate Signing Request (DER) Block 6-->
    <characteristic const="false" id="CSR_BLOCK6" name="Certificate Signing Request (DER) Block 6" sourceId="" uuid="f08b92da-a4ae-4875-81db-9d10753defc0">
      <informativeText>Abstract: This is certificate signing request for BATL device which is part of Vehicle Keyless Access. As the generated CSR would be upto 1536 bytes and there is a limitation from BLE SIG and Silicon Labs' stack we are splitting it into 8 blocks of 192 bytes each. This part contains 6th block.</informativeText>
      <value length="192" type="hex" variable_length="true">00</value>
