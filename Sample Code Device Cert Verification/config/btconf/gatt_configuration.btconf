    <characteristic const="false" id="DEVICE_CERT_LENGTH" name="Device Certificate Length" sourceId="" uuid="f38e3201-a8ff-4aed-ba42-7741f1d77445">
      <informativeText>Abstract: This is length of generated device certificate (in bytes).</informativeText>
      <value length="2" type="hex" variable_length="false">0000</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
        <write authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>

