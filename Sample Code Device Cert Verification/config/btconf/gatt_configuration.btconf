      <informativeText>Abstract: This is BLE MAC ID.</informativeText>
      <value length="6" type="hex" variable_length="false">00</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>
  </service>

  <!--BATL Pairing-->
  <service advertise="false" id="BATL_PAIRING" name="BATL Pairing" requirement="mandatory" sourceId="" type="primary" uuid="eef98d91-0c92-458a-8819-79105563d397">
    <informativeText>Abstract: This service is for pairing between two BATL device. This service assumes that both of them are already device provisioned.</informativeText>

    <!--Is Ready to Pair-->
    <characteristic const="false" id="IS_READY_2_PAIR" name="Is Ready to Pair" sourceId="" uuid="4387faf3-ea6c-44fd-93e2-e62ffcb0c84b">
      <informativeText>Abstract: This flag informs the EOL tool that the current device is ready to be paired with another BATL BLE device (should be device provisioned).</informativeText>
      <value length="1" type="hex" variable_length="false">00</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>

    <!--Is Pairing Requested?-->
    <characteristic const="false" id="IS_PAIRING_REQUESTED" name="Is Pairing Requested?" sourceId="" uuid="5cd78549-1b49-42c3-996e-f41c0aea221b">
      <informativeText>Abstract: This flag is being triggered by EOL device to initiate pairing between two BATL BLE devices (device provisioned).</informativeText>
      <value length="1" type="hex" variable_length="false">00</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
        <write authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>

    <!--Target Device to Pair-->
    <characteristic const="false" id="TARGET_DEVICE_2_PAIR" name="Target Device to Pair" sourceId="" uuid="4b665115-ecd4-43fe-b1f9-aab096258dc1">
      <informativeText>Abstract: EOL device should trigger pairing alongwith the target device address (6 bytes). This will inform the host device that with whom it needs to get connected and initiate pairing.</informativeText>
      <value length="6" type="hex" variable_length="false">00</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
        <write authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>

    <!--Is Pairing Successful?-->
    <characteristic const="false" id="IS_PAIRING_SUCCESSFUL" name="Is Pairing Successful?" sourceId="" uuid="dc37cde1-76ce-438b-a6c0-64b6495e815c">
      <informativeText>Abstract: This flag will inform EOL device that pairing between two host device (which was initiated by EOL device itself) is completed successful.</informativeText>
      <value length="1" type="hex" variable_length="false">00</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>

    <!--ECU Type-->
    <characteristic const="false" id="ECU_TYPE" name="ECU Type" sourceId="" uuid="d3468677-a166-475f-87b6-3f24bcc18a9f">
      <informativeText>Abstract: This will indicate either the ECU is VCU or Keyfob. These are indicated by enums where 0 = Unassigned, 1 = VCU, 2 = Keyfob.</informativeText>
      <value length="1" type="hex" variable_length="false">00</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
        <write authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>

    <!--ECU Role-->
    <characteristic const="false" id="ECU_ROLE" name="ECU Role" sourceId="" uuid="a8546a4a-0578-463e-97cc-a8dd74dfed42">
      <informativeText>Abstract: This will indicate either the current BLE device assums the role of central or peripheral. These are indicated by enums where 0 = Unassigned, 1 = Central, 2 = Peripheral.</informativeText>
      <value length="1" type="hex" variable_length="false">00</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
        <write authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>

    <!--OOB Data-->
    <characteristic const="false" id="OOB_DATA" name="OOB Data" sourceId="" uuid="83d4e742-47a2-4e75-9953-86fb5936a24a">
      <informativeText>Abstract: This will be used to read OOB data published by the target BLE device. OOB data contains random value, confirmation value and signature.</informativeText>
      <value length="96" type="hex" variable_length="false">00</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>
  </service>
</gatt>
