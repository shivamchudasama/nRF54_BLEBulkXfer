    <characteristic const="false" id="DEVICE_CERT_BLOCK3" name="Device Certificate Block 3" sourceId="" uuid="d579a4c7-fb92-4c56-b672-4fa7ce6ad8dd">
      <informativeText>Abstract: This is device certificate for BATL device which is part of Vehicle Keyless Access. As the generated certificate would be upto 1536 bytes and there is a limitation from BLE SIG and Silicon Labs' stack we are splitting it into 8 blocks of 192 bytes each. This part contains 3rd block.</informativeText>
      <value length="192" type="hex" variable_length="true">00</value>
