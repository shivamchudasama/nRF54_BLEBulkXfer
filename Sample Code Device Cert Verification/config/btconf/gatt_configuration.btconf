    </characteristic>

    <!--Device Certificate Block 8-->
    <characteristic const="false" id="DEVICE_CERT_BLOCK8" name="Device Certificate Block 8" sourceId="" uuid="a9bbeb42-4299-4272-86f8-ff70f55992b7">
      <informativeText>Abstract: This is device certificate for BATL device which is part of Vehicle Keyless Access. As the generated certificate would be upto 1536 bytes and there is a limitation from BLE SIG and Silicon Labs' stack we are splitting it into 8 blocks of 192 bytes each. This part contains 8th block.</informativeText>
      <value length="192" type="hex" variable_length="true">00</value>
