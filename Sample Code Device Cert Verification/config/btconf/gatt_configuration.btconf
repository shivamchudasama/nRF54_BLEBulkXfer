    <characteristic const="false" id="DEVICE_CERT_BLOCK6" name="Device Certificate Block 6" sourceId="" uuid="5d6d6cd0-d48c-40ee-963b-15072c02fda6">
      <informativeText>Abstract: This is device certificate for BATL device which is part of Vehicle Keyless Access. As the generated certificate would be upto 1536 bytes and there is a limitation from BLE SIG and Silicon Labs' stack we are splitting it into 8 blocks of 192 bytes each. This part contains 6th block.</informativeText>
      <value length="192" type="hex" variable_length="true">00</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
        <write authenticated="false" bonded="false" encrypted="false"/>
