    <characteristic const="false" id="CSR_BLOCK7" name="Certificate Signing Request (DER) Block 7" sourceId="" uuid="9942e3ee-1c38-4611-ad43-ab44517f9249">
      <informativeText>Abstract: This is certificate signing request for BATL device which is part of Vehicle Keyless Access. As the generated CSR would be upto 1536 bytes and there is a limitation from BLE SIG and Silicon Labs' stack we are splitting it into 8 blocks of 192 bytes each. This part contains 7th block.</informativeText>
      <value length="192" type="hex" variable_length="true">00</value>
      <properties>
        <read authenticated="false" bonded="false" encrypted="false"/>
      </properties>
    </characteristic>

    <!--Certificate Signing Request (DER) Block 8-->
    <characteristic const="false" id="CSR_BLOCK8" name="Certificate Signing Request (DER) Block 8" sourceId="" uuid="167f5761-790b-48ca-a0ee-c10b428cc858">
      <informativeText>Abstract: This is certificate signing request for BATL device which is part of Vehicle Keyless Access. As the generated CSR would be upto 1536 bytes and there is a limitation from BLE SIG and Silicon Labs' stack we are splitting it into 8 blocks of 192 bytes each. This part contains 8th block.</informativeText>
      <value length="192" type="hex" variable_length="true">00</value>
